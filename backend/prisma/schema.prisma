// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroContent {
  id            Int      @id @default(autoincrement())
  greetingId    String   @default("Halo, saya")
  greetingEn    String   @default("Hi there, I am")
  name          String
  titleId       String
  titleEn       String
  descriptionId String   @db.Text
  descriptionEn String   @db.Text
  profileImgUrl String?
  resumeUrl     String?
  instagramUrl  String?
  linkedinUrl   String?
  githubUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Experience {
  id            Int      @id @default(autoincrement())
  roleId        String
  roleEn        String
  company       String
  durationId    String
  durationEn    String
  descriptionId String   @db.Text
  descriptionEn String   @db.Text
  imageUrl      String?
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String?
  category  String   @default("Frontend")
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id            Int      @id @default(autoincrement())
  titleId       String
  titleEn       String
  descriptionId String   @db.Text
  descriptionEn String   @db.Text
  imageUrl      String?
  githubUrl     String?
  demoUrl       String?
  tags          String?
  backgroundColor String? @default("#1a1a1a")
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Certification {
  id            Int      @id @default(autoincrement())
  titleId       String
  titleEn       String
  issuerId      String
  issuerEn      String
  dateId        String
  dateEn        String
  imageUrl      String?
  credentialUrl String?
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomSection {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  navLabelId    String
  navLabelEn    String
  titleId       String
  titleEn       String
  contentId     String   @db.Text
  contentEn     String   @db.Text
  icon          String?
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
