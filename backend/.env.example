# Environment Mode (WAJIB di-set 'production' saat hosting agar JWT guard & proteksi aktif)
NODE_ENV="production"

# Database MySQL URL
# Format: mysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://root:@localhost:3306/portfolio_db"

# JWT Secret untuk otentikasi admin (Wajib ganti dengan string acak panjang di production)
# Generate contoh di terminal: openssl rand -base64 32
JWT_SECRET="ganti_dengan_jwt_secret_yang_sangat_rahasia_dan_panjang_minimal_32_karakter"

# Port backend (Pilih port yang BENAR-BENAR BEBAS di server Minibox)
# Catatan: port 5000, 5003, 5008, 5010, 5015, 5017, 5018, 5020, 5051 sudah terpakai di Minibox.
# Disarankan: cek dengan 'ss -tulpn | grep LISTEN' atau gunakan port alternatif seperti 5090 / 5100 / 5200
PORT=5090

# CORS Origin:
# - Karena menggunakan Single-Domain (Nginx reverse proxy), masukkan URL domain production Anda:
CORS_ORIGIN="https://yourdomain.com"
# - Jika dalam mode development lokal: CORS_ORIGIN="*"

# (Opsional) Setup Key untuk melindungi pemanggilan POST /api/admin/setup dari luar
ADMIN_SETUP_SECRET="kunci_rahasia_setup_awal"

# (Opsional) Username & password admin inisial saat seed atau setup pertama
ADMIN_INIT_USERNAME="admin"
ADMIN_INIT_PASSWORD="password_admin_yang_sangat_kuat"
